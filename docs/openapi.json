 "components": {
  "schemas": {
   "DeployIn": {
    "properties": {
     "model_version_id": {
      "type": "string",
      "format": "uuid",
      "title": "Model Version Id"
     },
     "mode": {
      "type": "string",
      "pattern": "^(full|canary)$",
      "title": "Mode",
      "default": "full"
     },
     "share": {
      "type": "number",
      "maximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Share",
      "default": 1.0
     }
    },
    "type": "object",
    "required": [
     "model_version_id"
    ],
    "title": "DeployIn"
   },
   "FeedbackIn": {
    "properties": {
     "operator": {
      "type": "string",
      "maxLength": 60,
      "minLength": 2,
      "title": "Operator"
     },
     "items": {
      "items": {
       "$ref": "#/components/schemas/Verdict"
      },
      "type": "array",
      "maxItems": 500,
      "minItems": 1,
      "title": "Items"
     }
    },
    "type": "object",
    "required": [
     "operator",
     "items"
    ],
    "title": "FeedbackIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LoadIn": {
    "properties": {
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "default": 14
     },
     "product": {
      "type": "string",
      "pattern": "^(pcb|pouch|bracket)$",
      "title": "Product",
      "default": "pcb"
     }
    },
    "type": "object",
    "title": "LoadIn"
   },
   "PromoteIn": {
    "properties": {
     "run_id": {
      "type": "string",
      "format": "uuid",
      "title": "Run Id",
      "description": "the inspection run the canary and the control shared"
     },
     "note": {
      "type": "string",
      "maxLength": 500,
      "minLength": 3,
      "title": "Note"
     }
    },
    "type": "object",
    "required": [
     "run_id",
     "note"
    ],
    "title": "PromoteIn"
   },
   "SimOperatorIn": {
    "properties": {
     "run_id": {
      "type": "string",
      "format": "uuid",
      "title": "Run Id"
     },
     "budget": {
      "type": "integer",
      "maximum": 500.0,
      "minimum": 1.0,
      "title": "Budget",
      "default": 40
     },
     "error_rate": {
      "type": "number",
      "maximum": 0.5,
      "minimum": 0.0,
      "title": "Error Rate",
      "default": 0.02
     }
    },
    "type": "object",
    "required": [
     "run_id"
    ],
    "title": "SimOperatorIn"
   },
   "StreamIn": {
    "properties": {
     "frames": {
      "type": "integer",
      "maximum": 20000.0,
      "minimum": 30.0,
      "title": "Frames",
      "default": 3000
     },
     "defect_rate": {
      "type": "number",
      "maximum": 0.5,
      "minimum": 0.0,
      "title": "Defect Rate",
      "default": 0.03
     },
     "supplier_change_at": {
      "anyOf": [
       {
        "type": "integer",
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Supplier Change At",
      "description": "frame from which 70% of boards carry the second supplier's capacitors"
     },
     "stream_seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Stream Seed",
      "default": 101
     }
    },
    "type": "object",
    "title": "StreamIn"
   },
   "TrainIn": {
    "properties": {
     "target_false_reject": {
      "type": "number",
      "maximum": 0.1,
      "minimum": 0.001,
      "title": "Target False Reject",
      "default": 0.01
     },
     "include_feedback": {
      "type": "boolean",
      "title": "Include Feedback",
      "default": true
     }
    },
